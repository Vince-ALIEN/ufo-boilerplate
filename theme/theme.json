	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--text-base)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--8)"
		},
		"elements": {
			"heading": {
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--4)",
						"right": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--chillax)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.03em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--chillax)",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.025em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--chillax)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--3)"
					}
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--instrument-serif)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--3)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--cinnabar-600)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--cinnabar-600)"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.75"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--4)"
					},
					"padding": {
						"left": "var(--wp--preset--spacing--4)",
						"right": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--4)"
					},
					"padding": {
						"left": "var(--wp--preset--spacing--6)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--slate-200)"
				},
				"border": {
					"color": "var(--wp--preset--color--slate-200)",
					"style": "solid",
					"width": "1px"
				}
			},
			"core/code": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--text-sm)"
				},
				"color": {
					"background": "var(--wp--preset--color--slate-100)",
					"text": "var(--wp--preset--color--slate-800)"
				},
				"border": {
					"radius": "4px",
					"color": "var(--wp--preset--color--slate-200)",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--6)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--slate-600)"
				},
				"typography": {
					"fontStyle": "italic"
				}
			}
		}
	}
}
