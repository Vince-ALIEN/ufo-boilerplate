{
	"autoload": {
		"classmap": [
			"inc/"
		]
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"sirbrillig/phpcs-changed": "^2.11",
		"sirbrillig/phpcs-variable-analysis": "^2.12",
		"wp-cli/i18n-command": "^2.6",
		"wp-coding-standards/wpcs": "^3.2"
	},
	"scripts": {
		"php:lint": "vendor/bin/phpcs -p -s --standard=../phpcs.xml.dist",
		"php:lint:errors": "vendor/bin/phpcs -p -s --standard=../phpcs.xml.dist --runtime-set ignore_warnings_on_exit 1",
		"php:lint:autofix": "vendor/bin/phpcbf --standard=../phpcs.xml.dist",
		"php:lint:changed": "vendor/bin/phpcs-changed --standard=../phpcs.xml.dist --git --git-unstaged",
		"make-pot": "wp i18n make-pot . languages/ufo-boilerplate.pot"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
